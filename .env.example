# =============================================================================
#  Kopieer dit bestand naar ".env" en vul je eigen gegevens in:
#
#      copy .env.example .env        (Windows)
#      cp   .env.example .env        (macOS / Linux)
#
#  ".env" staat in .dockerignore en .gitignore, dus je token komt niet in het
#  image en niet in git.
# =============================================================================

# Adres van Home Assistant, zonder slash aan het eind.
# Laat leeg om automatisch hetzelfde adres te gebruiken als waarop je het
# dashboard opent (handig als je het dashboard op HA zelf host).
HA_URL=http://192.168.1.10:8123

# Long-Lived Access Token:
# Home Assistant -> klik rechtsboven op je profiel -> Long-Lived Access Tokens
# -> Create Token -> kopieer de waarde hierheen.
HA_TOKEN=plak-hier-je-long-lived-access-token

# Hoe vaak de status wordt opgehaald, in seconden (minimaal 2).
HA_POLL_SECONDS=5

# Optioneel: poort op deze computer waarop het dashboard bereikbaar is.
# Standaard 8080. Handig als die poort al bezet is.
# HA_DASHBOARD_PORT=8080

# -----------------------------------------------------------------------------
#  Meer hoef je hier niet in te vullen.
#
#  De entiteiten (en desgewenst een ander adres/token) stel je in via de knop
#  "Instellingen" in het dashboard. Die keuzes worden bewaard in
#  ./config/config.json -- het volume, dus niet in de browser en niet in deze
#  container. Dat bestand mag je ook met een teksteditor aanpassen.
#
#  De waarden hierboven zijn de beginsituatie: zodra config.json bestaat, gaat
#  die vóór op dit bestand.
# -----------------------------------------------------------------------------
